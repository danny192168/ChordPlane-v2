---
// A static, CSS-only chord sheet. It stands in for a screenshot until real
// captures exist, and it shows the product's actual output: chords sitting
// above the lyric syllables they belong to.
---

<figure class="sheet" aria-label="Example ChordPlane chord sheet">
  <div class="sheet-head">
    <span class="sheet-title">Amazing Grace</span>
    <span class="sheet-key">Key G · capo 0</span>
  </div>

  <div class="sheet-line">
    <div class="sheet-chords">G                C</div>
    <div class="sheet-lyric">Amazing grace, how sweet the sound</div>
  </div>
  <div class="sheet-line">
    <div class="sheet-chords">     G                  D</div>
    <div class="sheet-lyric">That saved a wretch like me</div>
  </div>
  <div class="sheet-line">
    <div class="sheet-chords">G              C</div>
    <div class="sheet-lyric">I once was lost, but now am found</div>
  </div>
  <div class="sheet-line">
    <div class="sheet-chords">    Em          D      G</div>
    <div class="sheet-lyric">Was blind, but now I see</div>
  </div>

  <figcaption class="sheet-caption">
    Transposed live, with guitar and ukulele diagrams a tap away.
  </figcaption>
</figure>
