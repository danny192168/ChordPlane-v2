---
import PhoneFrame from './PhoneFrame.astro';
import Screenshot from './Screenshot.astro';
import ShotThemeSwitch from './ShotThemeSwitch.astro';

import viewer from '../assets/screenshots/song-viewer.png';
import viewerDark from '../assets/screenshots/song-viewer-dark.png';
import transpose from '../assets/screenshots/transpose.png';
import transposeDark from '../assets/screenshots/transpose-dark.png';
import diagrams from '../assets/screenshots/diagrams.png';
import diagramsDark from '../assets/screenshots/diagrams-dark.png';
import setlist from '../assets/screenshots/setlist-detail.png';
import setlistDark from '../assets/screenshots/setlist-detail-dark.png';
import share from '../assets/screenshots/share-setlist.png';
import shareDark from '../assets/screenshots/share-setlist-dark.png';
import artists from '../assets/screenshots/artists.png';
import artistsDark from '../assets/screenshots/artists-dark.png';

const shots = [
  {
    image: viewer,
    darkImage: viewerDark,
    caption: 'Chords sit above the syllable you play them on.',
  },
  {
    image: transpose,
    darkImage: transposeDark,
    caption: 'Move a song into any key, capo hint included.',
  },
  {
    image: diagrams,
    darkImage: diagramsDark,
    caption: 'Guitar and ukulele voicings, drawn on the device.',
  },
  {
    image: setlist,
    darkImage: setlistDark,
    caption: 'Set lists keep the running order for the night.',
  },
  {
    image: share,
    darkImage: shareDark,
    caption: 'Send the whole set list as a QR code, a link or a .cpl file.',
  },
  {
    image: artists,
    darkImage: artistsDark,
    caption: 'Artists group the library without folders.',
  },
];
---

<section class="section wrap" aria-labelledby="shots-title">
  <div class="strip-head">
    <div>
      <h2 id="shots-title">A look at the app</h2>
      <p class="fine-print" style="margin-top: 8px">
        Real captures from the Android build. Tap one to enlarge it, and switch
        the preview to see them in light or dark.
      </p>
    </div>
    <ShotThemeSwitch />
    <div class="strip-nav">
      <button type="button" data-strip="prev" aria-label="Previous screenshots">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m14 6-6 6 6 6"></path>
        </svg>
      </button>
      <button type="button" data-strip="next" aria-label="Next screenshots">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m10 6 6 6-6 6"></path>
        </svg>
      </button>
    </div>
  </div>

  <ul class="shot-strip" data-strip-track>
    {shots.map((shot) => (
      <li>
        <figure class="shot-item">
          <button
            class="shot-zoom"
            type="button"
            data-shot-zoom
            data-full-light={shot.image.src}
            data-full-dark={shot.darkImage.src}
            data-caption={shot.caption}
            aria-label={`Enlarge screenshot: ${shot.caption}`}
          >
            <PhoneFrame size="small">
              <Screenshot
                src={shot.image}
                darkSrc={shot.darkImage}
                alt={shot.caption}
                sizes="(min-width: 900px) 264px, 62vw"
                widths={[264, 400, 528]}
              />
            </PhoneFrame>
          </button>
          <figcaption>{shot.caption}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<dialog class="shot-dialog" data-shot-dialog aria-label="Screenshot preview">
  <img
    data-shot-dialog-image
    src={shots[0].image.src}
    alt=""
    width="1080"
    height="2400"
  />
  <p class="shot-dialog-caption" data-shot-dialog-caption>{shots[0].caption}</p>
  <button
    class="shot-dialog-close"
    type="button"
    data-shot-dialog-close
    aria-label="Close screenshot"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-shot-dialog]');
  const dialogImage = document.querySelector<HTMLImageElement>(
    '[data-shot-dialog-image]',
  );
  const dialogCaption = document.querySelector<HTMLElement>(
    '[data-shot-dialog-caption]',
  );
  const closeButton = document.querySelector<HTMLButtonElement>(
    '[data-shot-dialog-close]',
  );
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-shot-zoom]'),
  );

  let lastTrigger: HTMLButtonElement | null = null;

  const fullFor = (trigger: HTMLButtonElement) => {
    const mode = document.documentElement.dataset.shotTheme === 'dark' ? 'dark' : 'light';
    return mode === 'dark' ? trigger.dataset.fullDark : trigger.dataset.fullLight;
  };

  const showCurrent = () => {
    if (!dialogImage || !lastTrigger) return;
    dialogImage.src = fullFor(lastTrigger) ?? '';
  };

  if (dialog && dialogImage && dialogCaption) {
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        lastTrigger = trigger;
        showCurrent();
        const caption = trigger.dataset.caption ?? '';
        dialogImage.alt = caption;
        dialogCaption.textContent = caption;
        dialog.showModal();
        document.documentElement.classList.add('lightbox-open');
      });
    });

    // Keep an open zoomed screenshot in step with the preview switch.
    window.addEventListener('chordplane:shot-theme', showCurrent);

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      lastTrigger?.focus();
      lastTrigger = null;
    });

    // Clicks on the backdrop land on the dialog itself, outside its box.
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) dialog.close();
    });

    closeButton?.addEventListener('click', () => dialog.close());
  }

  // Screenshot strip arrows.
  const track = document.querySelector<HTMLElement>('[data-strip-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-strip="prev"]');
  const next = document.querySelector<HTMLButtonElement>('[data-strip="next"]');

  if (track && prev && next) {
    const step = () => Math.max(260, track.clientWidth * 0.7);
    const sync = () => {
      prev.disabled = track.scrollLeft < 8;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
    };

    prev.addEventListener('click', () =>
      track.scrollBy({ left: -step(), behavior: 'smooth' }),
    );
    next.addEventListener('click', () =>
      track.scrollBy({ left: step(), behavior: 'smooth' }),
    );
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
