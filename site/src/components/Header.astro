---
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/logo.svg" alt="" width="30" height="30" />
      <span>ChordPlane</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href="/privacy/" class="nav-secondary">Privacy</a>
      <a
        href="https://github.com/danny192168/ChordPlane-v2"
        class="nav-secondary"
        rel="noopener">GitHub</a
      >
      <a href="/download/" class="nav-cta" aria-current={path.startsWith('/download') ? 'page' : undefined}>
        Download
      </a>
    </nav>
  </div>
</header>
