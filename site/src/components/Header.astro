---
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="ChordPlane home">
      <img src="/logo.svg" alt="" width="30" height="30" />
      <span>ChordPlane</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href="/privacy/" class="nav-secondary">Privacy</a>
      <a
        href="https://github.com/danny192168/ChordPlane-v2"
        class="nav-secondary nav-github"
        rel="noopener"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" width="15" height="15">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span class="nav-github-label">GitHub</span>
      </a>
      <a href="/download/" class="nav-cta" aria-current={path.startsWith('/download') ? 'page' : undefined}>
        Get the App
      </a>
      <button
        class="theme-switch"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Dark theme"
        data-theme-toggle
      >
        <span class="switch-track">
          <span class="switch-knob">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
              <path d="M20.5 14.2A8.4 8.4 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
            </svg>
          </span>
        </span>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const query = window.matchMedia('(prefers-color-scheme: dark)');

  const resolved = () =>
    root.dataset.theme === 'light' || root.dataset.theme === 'dark'
      ? root.dataset.theme
      : query.matches
        ? 'dark'
        : 'light';

  const paint = () => {
    if (!button) return;
    const mode = resolved();
    button.dataset.mode = mode;
    button.setAttribute('aria-checked', String(mode === 'dark'));
    button.setAttribute('aria-label', mode === 'dark' ? 'Light theme' : 'Dark theme');
  };

  button?.addEventListener('click', () => {
    const next = resolved() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('chordplane-theme', next);
    } catch (_) {
      /* Storage is optional; the switch still works for this page. */
    }
    paint();
  });

  query.addEventListener('change', paint);
  paint();
</script>
