---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import ReleaseInfo from '../components/ReleaseInfo.astro';
import FretRail from '../components/FretRail.astro';
import Gallery from '../components/Gallery.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Screenshot from '../components/Screenshot.astro';
import Showcase from '../components/Showcase.astro';
import viewer from '../assets/screenshots/song-viewer.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ChordPlane',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Android 7.0+',
  url: 'https://chordplane.citcs.site/download/',
  downloadUrl:
    'https://github.com/danny192168/ChordPlane-v2/releases/latest/download/chordplane-latest.apk',
  description:
    'A guitar-first chord and lyric songbook. Chords sit above the lyrics, songs transpose into any key, and everything stays on your device.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base
  title="ChordPlane — a guitar-first chord and lyric songbook"
  description="Chords above lyrics, transpose in any key, chord diagrams and set lists. Songs stay on your device; the cloud only appears when you share a link."
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <div class="hero-copy">
      <span class="eyebrow"><span class="eyebrow-dot"></span>Android · free · offline first</span>
      <h1>Your set list, ready <em>before the first chord.</em></h1>
      <p class="lede">
        ChordPlane keeps chords above the words they belong to, moves a song
        into any key without turning it unreadable, and shows the voicing while
        you play. Your library is a file on your phone — the cloud only appears
        when you choose to share.
      </p>

      <div class="actions">
        <a
          id="download-apk"
          class="btn btn-primary"
          href="https://github.com/danny192168/ChordPlane-v2/releases/latest/download/chordplane-latest.apk"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
            <path
              d="M12 3v11m0 0 4.5-4.5M12 14 7.5 9.5M5 17.5V19a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Download for Android
        </a>
        <a class="btn btn-quiet" href="#inside">See it in the app</a>
      </div>

      <ReleaseInfo />
    </div>

    <div class="hero-stage">
      <FretRail class="hero-rail" />
      <div class="hero-halo" aria-hidden="true"></div>

      <div class="hero-phone">
        <PhoneFrame>
          <Screenshot
            src={viewer}
            alt="Amazing Grace open in ChordPlane: chords in navy sit above each lyric line, with the key and tempo in chips at the top."
            eager
            sizes="(min-width: 900px) 340px, 70vw"
          />
        </PhoneFrame>
      </div>

      <div class="float-card chord-card" aria-hidden="true">
        <div class="float-card-head">
          <span class="chord-name">G</span>
          <span class="float-card-note">guitar</span>
        </div>
        <svg viewBox="0 0 120 132" role="presentation">
          <g class="diagram-frets">
            <line x1="20" y1="30" x2="100" y2="30" class="diagram-nut"></line>
            <line x1="20" y1="52" x2="100" y2="52"></line>
            <line x1="20" y1="74" x2="100" y2="74"></line>
            <line x1="20" y1="96" x2="100" y2="96"></line>
            <line x1="20" y1="118" x2="100" y2="118"></line>
          </g>
          <g class="diagram-strings">
            <line x1="20" y1="30" x2="20" y2="118"></line>
            <line x1="36" y1="30" x2="36" y2="118"></line>
            <line x1="52" y1="30" x2="52" y2="118"></line>
            <line x1="68" y1="30" x2="68" y2="118"></line>
            <line x1="84" y1="30" x2="84" y2="118"></line>
            <line x1="100" y1="30" x2="100" y2="118"></line>
          </g>
          <g class="diagram-dots">
            <circle cx="20" cy="85" r="6.5"></circle>
            <circle cx="36" cy="63" r="6.5"></circle>
            <circle cx="100" cy="85" r="6.5"></circle>
          </g>
          <g class="diagram-open">
            <circle cx="52" cy="20" r="3.5"></circle>
            <circle cx="68" cy="20" r="3.5"></circle>
            <circle cx="84" cy="20" r="3.5"></circle>
          </g>
        </svg>
      </div>

      <div class="float-card list-card" aria-hidden="true">
        <div class="float-card-head">
          <span>Sunday Set</span>
          <span class="float-card-note">4 songs</span>
        </div>
        <ol>
          <li><span class="list-num">1</span>Amazing Grace <em>G</em></li>
          <li><span class="list-num">2</span>Simple Gifts <em>G</em></li>
          <li><span class="list-num">3</span>Down to the River <em>G</em></li>
          <li><span class="list-num">4</span>Wayfaring Stranger <em>Am</em></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="band" aria-label="What ChordPlane does">
    <div class="wrap band-inner">
      <span>Chords above lyrics</span>
      <span>Transpose ±11</span>
      <span>Guitar &amp; ukulele diagrams</span>
      <span>Set lists</span>
      <span>Share links</span>
    </div>
  </section>

  <Showcase />

  <Gallery />

  <section class="section wrap import-section" aria-labelledby="import-title">
    <div class="import-copy">
      <span class="eyebrow">Bring your own</span>
      <h2 id="import-title">The sheets you already have still work.</h2>
      <p>
        Paste a lead sheet with bracketed chords, a plain-text chord row, a
        ChordPro export from another app, or a list copied out of a message.
        ChordPlane detects the format, keeps the sections, and lays it out as a
        sheet you can play from.
      </p>
      <ul class="import-list">
        <li>ChordPro (<code>[G]</code>) and plain chord rows</li>
        <li>Section labels, repeats, capo and tempo</li>
        <li>Nothing is uploaded to read it</li>
      </ul>
      <a class="text-link" href="/download/">Install it and paste a sheet →</a>
    </div>

    <div class="import-sheet">
      <Sheet />
    </div>
  </section>

  <section class="section wrap statement-section" aria-labelledby="privacy-title">
    <div class="section-head">
      <span class="eyebrow">Privacy</span>
      <h2 id="privacy-title">Nothing leaves the phone unless you share it.</h2>
    </div>

    <div class="statement">
      <p>
        No analytics, no adverts, no background sync. Your library is a database
        file on your device, and it stays there.
      </p>
      <footer>
        <a class="text-link" href="/privacy/">Read the full privacy note →</a>
      </footer>
    </div>

    <ul class="privacy-points">
      <li>
        An account is optional — it exists so a share link can be traced back to
        you and deleted later.
      </li>
      <li>
        A share link stores exactly the sheet you sent, not the rest of your
        library.
      </li>
      <li>
        Google sign-in receives only your email address, name and profile
        picture.
      </li>
    </ul>
  </section>

  <section class="section wrap get-section" aria-labelledby="get-title">
    <div class="get-card">
      <div>
        <span class="eyebrow">Get it</span>
        <h2 id="get-title">Ready before the downbeat.</h2>
        <p>
          ChordPlane installs from a signed APK, straight from the releases
          page. Updates install over the old build and keep your songs.
        </p>
      </div>
      <div class="get-actions">
        <a
          class="btn btn-primary"
          href="https://github.com/danny192168/ChordPlane-v2/releases/latest/download/chordplane-latest.apk"
          rel="noopener">Download for Android</a
        >
        <a class="btn btn-quiet" href="/download/">Install instructions</a>
        <p class="fine-print">Android 7.0 or newer. iOS is not available yet.</p>
      </div>
    </div>
  </section>
</Base>
