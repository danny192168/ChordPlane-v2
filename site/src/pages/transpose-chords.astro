---
import Base from '../layouts/Base.astro';
import Screenshot from '../components/Screenshot.astro';
import transpose from '../assets/screenshots/transpose.png';
import transposeDark from '../assets/screenshots/transpose-dark.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How far can ChordPlane transpose a song?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Up to eleven semitones in either direction. Chords, diagrams and the displayed key move together, while the lyric layout stays in place.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does transposing change the original song?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Transposition is a view setting on top of the stored sheet. The original key remains in the editor and you can reset to it at any time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I transpose for a capo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The capo value is stored with the song and shown alongside the key, so you can keep the shape you play while singing in a different key.',
      },
    },
  ],
};
---

<Base
  title="Transpose chords on Android without rewriting the song | ChordPlane"
  description="Move a chord sheet into any key on Android. Chords, diagrams and capo hints update together while lyrics stay readable. Works offline."
  jsonLd={jsonLd}
>
  <section class="wrap hero">
    <div class="hero-inner">
      <p class="screen-kicker">Transpose chords</p>
      <h1>Change the key, not the whole sheet.</h1>
      <p class="lede">
        Singing too low? Capo too high? ChordPlane transposes a song by up to
        eleven semitones without scrambling the lyric layout. The chords, the
        diagrams and the key label all move together.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/download/">Download for Android</a>
        <a class="btn btn-quiet" href="#how">How it works</a>
      </div>
    </div>
  </section>

  <section class="section wrap import-section" id="how" aria-labelledby="transpose-how-title">
    <div class="import-copy">
      <h2 id="transpose-how-title">The transpose control stays out of the way</h2>
      <p style="margin-top: 14px; color: var(--ink-soft)">
        Open a song and choose Key. A sheet slides up with a wide slider and a
        live preview. Move it until the vocal sits comfortably, then dismiss
        the sheet. The lyric lines underneath never shift.
      </p>
      <ul class="import-list">
        <li>Semitone steps from −11 to +11</li>
        <li>Sharp and flat spelling chosen from the original key</li>
        <li>Capo shown next to the transposed key</li>
        <li>Reset to original in one tap</li>
      </ul>
      <a class="text-link" href="/chordpro-reader/">Import a ChordPro sheet →</a>
    </div>
    <div class="import-sheet">
      <Screenshot
        src={transpose}
        darkSrc={transposeDark}
        alt="Transpose sheet open over a chord and lyric song"
      />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="why-title">
    <div class="section-head">
      <h2 id="why-title">Why it feels different</h2>
      <p>
        Most chord apps either rewrite the text or force you to recalculate
        every shape by hand. ChordPlane treats transposition as a layer.
      </p>
    </div>
    <div class="feature-grid">
      <article>
        <h3>Lyrics stay put</h3>
        <p>
          Chords are attached to syllables, so changing the key only changes
          the chord labels. The verse you already learned to read stays still.
        </p>
      </article>
      <article>
        <h3>Diagrams follow</h3>
        <p>
          Tap a transposed chord and the voicing sheet shows the new shape for
          guitar or ukulele. No mental transposition while you are playing.
        </p>
      </article>
      <article>
        <h3>Capo included</h3>
        <p>
          The capo value lives with the song. A capo 2 sheet and a +2 transpose
          produce the same sounding key with the shapes you already know.
        </p>
      </article>
      <article>
        <h3>Nothing is uploaded</h3>
        <p>
          Transposition happens locally, even in airplane mode. It is the same
          code path whether the song was typed today or imported last year.
        </p>
      </article>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="transpose-faq-title">
    <div class="section-head">
      <h2 id="transpose-faq-title">Transpose questions</h2>
    </div>
    <ul class="points">
      <li>
        <h3>How far can ChordPlane transpose a song?</h3>
        <p>
          Eleven semitones in either direction, enough to move most songs into
          a comfortable vocal range.
        </p>
      </li>
      <li>
        <h3>Does transposing change the original song?</h3>
        <p>
          No. The original key is kept in the editor and the reset button
          returns the view to it instantly.
        </p>
      </li>
      <li>
        <h3>Can I transpose for a capo?</h3>
        <p>
          Yes. The capo hint is stored with the sheet and shown alongside the
          key label while you play.
        </p>
      </li>
    </ul>
  </section>

  <section class="wrap" style="padding-block: clamp(44px, 6vw, 80px)">
    <div class="get-card">
      <div>
        <h2>Find the key that fits your voice.</h2>
        <p>Install ChordPlane and open any song to try the transpose sheet.</p>
      </div>
      <div class="get-actions">
        <a class="btn btn-primary" href="/download/">Download for Android</a>
        <a class="btn btn-quiet" href="/ukulele-chords/">Ukulele chords</a>
      </div>
    </div>
  </section>
</Base>
